<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!--
      WFO0003 recommends Application.SetHighDpiMode for Windows Forms applications. RDCM is a WPF application, which
      declares DPI awareness in app.manifest (the documented mechanism for WPF); SetHighDpiMode would run too late.
    -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationIcon>Assets\RDCM.ico</ApplicationIcon>
    <AssemblyTitle>RDCM</AssemblyTitle>
    <!--
      Restore always includes the installer's runtime (win-x64), so building the installer (which publishes for win-x64)
      leaves the same restore output as a normal build instead of changing it under the IDE and other builds.
      This affects restore only; normal builds stay runtime-independent.
    -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="RDCM.Tests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\RDCM.ico" />
  </ItemGroup>
</Project>
