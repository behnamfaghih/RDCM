<Window x:Class="RDCM.ProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RDCM"
        Title="New connection"
        Width="520"
        SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindowStyle}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="24,20,24,24">
                <TextBlock x:Name="HeadingText" Text="New connection" Style="{StaticResource TitleText}" />
                <TextBlock x:Name="SubheadingText" Text="Save a reusable Remote Desktop profile."
                           Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,20" />

                <Label Content="Connection _name" Target="{Binding ElementName=NameBox}" />
                <TextBox x:Name="NameBox" AutomationProperties.Name="Connection name"
                         local:UiAssist.Placeholder="e.g. Build server" />
                <TextBlock x:Name="NameError" Style="{StaticResource FieldErrorText}" />

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Content="_Computer name or IP address" Target="{Binding ElementName=HostBox}" />
                    <TextBox x:Name="HostBox" Grid.Row="1" AutomationProperties.Name="Computer name or IP address"
                             local:UiAssist.Placeholder="server.example.com or 10.0.0.5" />
                    <Label Grid.Column="2" Content="_Port" Target="{Binding ElementName=PortBox}" />
                    <TextBox x:Name="PortBox" Grid.Row="1" Grid.Column="2" Text="3389"
                             AutomationProperties.Name="Port" />
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
                        <TextBlock x:Name="HostError" Style="{StaticResource FieldErrorText}" />
                        <TextBlock x:Name="PortError" Style="{StaticResource FieldErrorText}" />
                    </StackPanel>
                </Grid>

                <Label Content="_Username" Target="{Binding ElementName=UsernameBox}" Margin="0,16,0,6" />
                <TextBox x:Name="UsernameBox" AutomationProperties.Name="Username (optional)"
                         AutomationProperties.HelpText="Optional. Passwords are never stored; Remote Desktop prompts when connecting."
                         local:UiAssist.Placeholder="Optional, e.g. DOMAIN\user" />
                <TextBlock x:Name="UsernameError" Style="{StaticResource FieldErrorText}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <local:Glyph Style="{StaticResource IconGlyph}" Text="&#xE72E;" FontSize="11"
                               Foreground="{DynamicResource SecondaryText}" Margin="0,0,6,0" />
                    <TextBlock Text="Passwords are never stored. You'll be prompted when connecting."
                               Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                </StackPanel>

                <Label Content="_Group" Target="{Binding ElementName=GroupBox}" Margin="0,16,0,6" />
                <ComboBox x:Name="GroupBox" IsEditable="True" Text="General" AutomationProperties.Name="Group"
                          AutomationProperties.HelpText="Choose an existing group or type a new one." />
                <TextBlock x:Name="GroupError" Style="{StaticResource FieldErrorText}" />

                <Label Content="No_tes" Target="{Binding ElementName=NotesBox}" Margin="0,16,0,6" />
                <TextBox x:Name="NotesBox" Height="56" TextWrapping="Wrap" AcceptsReturn="False"
                         VerticalContentAlignment="Top" Padding="8,6" VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Notes (optional)"
                         local:UiAssist.Placeholder="Optional" />
                <TextBlock x:Name="NotesError" Style="{StaticResource FieldErrorText}" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource HeaderBackground}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" IsDefault="True" Click="Save_Click" Style="{StaticResource AccentButton}"
                        MinWidth="96" ToolTip="Save without connecting (Enter)"
                        AutomationProperties.Name="Save profile without connecting" />
                <Button Content="Save &amp; connect" Click="SaveAndConnect_Click" MinWidth="96" Margin="8,0,0,0"
                        ToolTip="Save and open a session (Ctrl+Enter)"
                        AutomationProperties.Name="Save profile and connect" />
                <Button Content="Cancel" IsCancel="True" MinWidth="96" Margin="8,0,0,0"
                        AutomationProperties.Name="Cancel profile editing" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
