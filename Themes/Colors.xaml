<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!--
        Default (dark) values for the semantic colour tokens. ThemeManager replaces every
        key at runtime for Light, Dark, and High Contrast, so all usages must be DynamicResource.
    -->
    <SolidColorBrush x:Key="WindowBackground" Color="#1A1B1E" />
    <SolidColorBrush x:Key="HeaderBackground" Color="#222327" />
    <SolidColorBrush x:Key="PanelBackground" Color="#222327" />
    <SolidColorBrush x:Key="SurfaceBackground" Color="#141517" />
    <SolidColorBrush x:Key="ControlBackground" Color="#2B2D31" />
    <SolidColorBrush x:Key="ControlHover" Color="#34363B" />
    <SolidColorBrush x:Key="ControlPressed" Color="#26282C" />
    <SolidColorBrush x:Key="InputFocusBackground" Color="#1E1F23" />
    <SolidColorBrush x:Key="BorderBrushColor" Color="#3D4046" />
    <SolidColorBrush x:Key="StrongBorderBrush" Color="#5A5E66" />
    <SolidColorBrush x:Key="DividerBrush" Color="#313338" />
    <SolidColorBrush x:Key="PanelHover" Color="#2C2E33" />
    <SolidColorBrush x:Key="SelectedBackground" Color="#2D3B50" />
    <SolidColorBrush x:Key="SelectedText" Color="#F1F3F5" />
    <SolidColorBrush x:Key="PrimaryText" Color="#E9EBEE" />
    <SolidColorBrush x:Key="SecondaryText" Color="#AEB3BB" />
    <SolidColorBrush x:Key="TertiaryText" Color="#8E949D" />
    <SolidColorBrush x:Key="DisabledText" Color="#6B7079" />
    <SolidColorBrush x:Key="AccentBrush" Color="#5AA2FF" />
    <SolidColorBrush x:Key="AccentText" Color="#8CC0FF" />
    <SolidColorBrush x:Key="AccentButtonBackground" Color="#2E6BD1" />
    <SolidColorBrush x:Key="AccentButtonHover" Color="#3A78DE" />
    <SolidColorBrush x:Key="AccentButtonPressed" Color="#285FBC" />
    <SolidColorBrush x:Key="AccentButtonBorder" Color="#3A78DE" />
    <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#4CC38A" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E5AE4A" />
    <SolidColorBrush x:Key="FavoriteBrush" Color="#F2C14E" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#F07A74" />
    <SolidColorBrush x:Key="FocusBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PopupBackground" Color="#2A2C30" />
    <SolidColorBrush x:Key="PopupBorder" Color="#45484F" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#5A5E66" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#7A7F88" />
    <SolidColorBrush x:Key="IconBackground" Color="#26364C" />

    <!-- Typography -->
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle">16</sys:Double>
    <sys:Double x:Key="FontSizeTitle">20</sys:Double>
    <sys:Double x:Key="FontSizeIcon">14</sys:Double>

    <!-- Shape -->
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">6</CornerRadius>

    <!-- Density: connection list rows (standard two-line and compact single-line) -->
    <Thickness x:Key="ListItemPadding">10,6,8,6</Thickness>
    <Thickness x:Key="ListItemMargin">0,1</Thickness>
    <Thickness x:Key="ListItemPaddingCompact">10,3,8,3</Thickness>
    <Thickness x:Key="ListItemMarginCompact">0</Thickness>
</ResourceDictionary>
