<UserControl x:Class="RDCM.SessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RDCM">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Session toolbar: state · status · display options · session actions -->
        <Border Background="{DynamicResource WindowBackground}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                Padding="12,5,8,5" MinHeight="40">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse x:Name="StateDot" Style="{StaticResource StateDot}" Margin="0,0,10,0" />
                <TextBlock x:Name="StatusTextBlock" Grid.Column="1" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="ServerIdentityChip" Visibility="Collapsed"
                        BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}" Padding="7,2,8,2" Margin="0,0,12,0"
                        VerticalAlignment="Center" Focusable="True" KeyboardNavigation.IsTabStop="True"
                        FocusVisualStyle="{StaticResource FocusRingInset}"
                        AutomationProperties.Name="Server identity not verified">
                    <StackPanel Orientation="Horizontal">
                        <local:Glyph Style="{StaticResource IconGlyph}" Text="&#xE7BA;" FontSize="12"
                                   Foreground="{DynamicResource WarningBrush}" />
                        <TextBlock x:Name="ServerIdentityText" Text="Server identity not verified"
                                   FontSize="{StaticResource FontSizeCaption}" Margin="6,0,0,0"
                                   Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border x:Name="ProfileChangedChip" Visibility="Collapsed"
                        BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}" Padding="7,2,8,2" Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        ToolTip="The saved profile was edited. Reconnect to use the updated settings."
                        AutomationProperties.Name="Profile changed. Reconnect to apply.">
                    <StackPanel Orientation="Horizontal">
                        <local:Glyph Style="{StaticResource IconGlyph}" Text="&#xE7BA;" FontSize="12"
                                   Foreground="{DynamicResource WarningBrush}" />
                        <TextBlock x:Name="ProfileChangedText" Text="Profile changed · reconnect to apply"
                                   FontSize="{StaticResource FontSizeCaption}" Margin="6,0,0,0"
                                   Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ResolutionLabel" Text="Resolution" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="ResolutionPicker" Width="132" MinHeight="28"
                              AutomationProperties.LabeledBy="{Binding ElementName=ResolutionLabel}"
                              AutomationProperties.HelpText="Changes resolution in the remote desktop session."
                              ToolTip="Remote desktop resolution (changes the remote session, not RDCM)" />
                    <TextBlock x:Name="ScaleLabel" Text="DPI scale" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" Margin="14,0,8,0" />
                    <ComboBox x:Name="ScalePicker" Width="80" MinHeight="28"
                              AutomationProperties.LabeledBy="{Binding ElementName=ScaleLabel}"
                              AutomationProperties.HelpText="Changes scale in the remote desktop session."
                              ToolTip="DPI scale applies to the remote session" />
                </StackPanel>

                <Border Grid.Column="4" Style="{StaticResource VerticalDivider}" Margin="10,0,6,0" />

                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ReconnectButton" Style="{StaticResource SubtleButton}"
                            local:UiAssist.Icon="&#xE72C;" Content="Reconnect"
                            ToolTip="Reconnect this remote session" />
                    <Button x:Name="DisconnectButton" Style="{StaticResource SubtleButton}"
                            local:UiAssist.Icon="&#xE73B;" local:UiAssist.IconSize="11"
                            Content="Disconnect" Margin="2,0,0,0"
                            ToolTip="Disconnect this remote session" />
                    <Button x:Name="AppControlsButton" Style="{StaticResource IconButton}"
                            local:UiAssist.Icon="&#xE765;" Margin="2,0,0,0"
                            ToolTip="Release keyboard: move keyboard focus from the remote desktop back to RDCM" />
                </StackPanel>
            </Grid>
        </Border>

        <ProgressBar x:Name="ActivityBar" Style="{StaticResource ActivityBar}"
                     VerticalAlignment="Bottom" Visibility="Collapsed"
                     AutomationProperties.Name="Connecting" />

        <!-- Native RDP surface (WindowsFormsHost) is placed here by MainWindow -->
        <Border x:Name="HostContainer" Grid.Row="1" Background="{DynamicResource SurfaceBackground}" />

        <!--
            The native RDP surface is an HWND (WindowsFormsHost), so WPF cannot draw over it. Instead the host is
            hidden whenever the session is not connected and this panel is shown in the same layout cell.
        -->
        <Grid x:Name="StatePanel" Grid.Row="1" Background="{DynamicResource SurfaceBackground}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Margin="24">
                    <local:Glyph x:Name="StateIcon" Style="{StaticResource IconGlyph}" Text="&#xE7F4;" FontSize="36"
                                 Foreground="{DynamicResource TertiaryText}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="StateTitle" Style="{StaticResource SubtitleText}" TextAlignment="Center"
                               TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock x:Name="StateMessage" Foreground="{DynamicResource SecondaryText}"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock x:Name="StateHint" Style="{StaticResource CaptionText}" Foreground="{DynamicResource TertiaryText}"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
                    <StackPanel x:Name="StateActions" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button x:Name="PanelPrimaryButton" Style="{StaticResource AccentButton}"
                                local:UiAssist.Icon="&#xE72C;" Content="Reconnect" MinWidth="112" Margin="0,0,8,0" />
                        <Button x:Name="PanelCancelButton" Content="Cancel" MinWidth="96" Margin="0,0,8,0" />
                        <Button x:Name="PanelCloseButton" Content="Close tab" MinWidth="96" />
                    </StackPanel>
                    <Button x:Name="PanelCopyButton" Style="{StaticResource SubtleButton}" HorizontalAlignment="Center"
                            Margin="0,10,0,0" local:UiAssist.Icon="&#xE8C8;" Content="Copy details"
                            Click="PanelCopyButton_Click" Visibility="Collapsed"
                            ToolTip="Copy error codes and versions for a support request. Connection, computer, and user names are left out."
                            AutomationProperties.Name="Copy diagnostic details" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
