<Window x:Class="RDCM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RDCM"
        Title="RDCM"
        Icon="Assets/RDCM.ico"
        Height="800"
        Width="1280"
        MinHeight="560"
        MinWidth="900"
        Style="{StaticResource AppWindowStyle}"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Window.Resources>
        <local:ProfileSessionIndicatorConverter x:Key="SessionIndicatorConverter" />
        <local:ProfileIdInSetConverter x:Key="IdInSetConverter" />
        <local:ProfileAutomationStatusConverter x:Key="AutomationStatusConverter" />
        <local:GroupExpansionConverter x:Key="GroupExpansionConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================== Command bar ============================== -->
        <Border Background="{DynamicResource HeaderBackground}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                Padding="6,5">
            <DockPanel LastChildFill="False">
                <Button x:Name="SidebarToggleButton" Style="{StaticResource IconButton}"
                        local:UiAssist.Icon="&#xE90C;" Click="ToggleSidebar_Click"
                        ToolTip="Hide connections (Ctrl+B)"
                        AutomationProperties.Name="Hide connections sidebar" />
                <Border Style="{StaticResource VerticalDivider}" />
                <Button Style="{StaticResource SubtleButton}" local:UiAssist.Icon="&#xE710;"
                        Content="New" Click="Add_Click"
                        ToolTip="New connection (Ctrl+N)"
                        AutomationProperties.Name="Create new connection profile" />
                <Button x:Name="ConnectButton" Style="{StaticResource SubtleButton}" local:UiAssist.Icon="&#xE768;"
                        Content="Connect" Click="Connect_Click" IsEnabled="False" Margin="2,0,0,0"
                        ToolTip="Connect to the selected profile (Enter or Ctrl+Enter)"
                        AutomationProperties.Name="Connect selected profile in a workspace tab" />
                <Button x:Name="EditButton" Style="{StaticResource SubtleButton}" local:UiAssist.Icon="&#xE70F;"
                        Content="Edit" Click="Edit_Click" IsEnabled="False" Margin="2,0,0,0"
                        ToolTip="Edit the selected profile (F2)"
                        AutomationProperties.Name="Edit selected connection profile" />
                <Button x:Name="RemoveButton" Style="{StaticResource SubtleButton}" local:UiAssist.Icon="&#xE74D;"
                        Content="Remove" Click="Remove_Click" IsEnabled="False" Margin="2,0,0,0"
                        ToolTip="Remove the selected profile (Delete)"
                        AutomationProperties.Name="Remove selected connection profile" />
                <Border Style="{StaticResource VerticalDivider}" />
                <Button Style="{StaticResource SubtleButton}" local:UiAssist.Icon="&#xE8B5;"
                        Content="Import" Click="Import_Click"
                        ToolTip="Import profiles from an RDCM JSON export"
                        AutomationProperties.Name="Import connection profiles" />
                <Button Style="{StaticResource SubtleButton}" local:UiAssist.Icon="&#xEDE1;"
                        Content="Export" Click="Export_Click" Margin="2,0,0,0"
                        ToolTip="Export all profiles to a JSON file"
                        AutomationProperties.Name="Export connection profiles" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,2,0">
                    <Button x:Name="CommandPaletteButton" Style="{StaticResource SubtleButton}"
                            local:UiAssist.Icon="&#xE721;" Click="CommandPalette_Click"
                            ToolTip="Go to a connection, open session, or command (Ctrl+Shift+P)"
                            AutomationProperties.Name="Open command palette"
                            AutomationProperties.AcceleratorKey="Ctrl+Shift+P">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Go to…" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Border Style="{StaticResource Keycap}"><TextBlock Text="Ctrl" /></Border>
                            <Border Style="{StaticResource Keycap}"><TextBlock Text="Shift" /></Border>
                            <Border Style="{StaticResource Keycap}" Margin="0"><TextBlock Text="P" /></Border>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" local:UiAssist.Icon="&#xE897;" Margin="2,0,0,0"
                            Click="ShortcutReference_Click"
                            ToolTip="Keyboard shortcuts (F1)"
                            AutomationProperties.Name="Show keyboard shortcuts"
                            AutomationProperties.AcceleratorKey="F1" />
                    <Border Style="{StaticResource VerticalDivider}" />
                    <local:Glyph Style="{StaticResource IconGlyph}" Text="&#xE790;"
                               Foreground="{DynamicResource SecondaryText}" Margin="0,0,8,0" />
                    <ComboBox x:Name="AppearanceBox" Width="100" MinHeight="28" SelectedIndex="0"
                              SelectionChanged="AppearanceBox_SelectionChanged"
                              AutomationProperties.Name="Application appearance"
                              ToolTip="Appearance: System, Light, or Dark">
                        <ComboBoxItem Content="System" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================== Main area ============================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ProfileColumn" Width="318" MinWidth="240" MaxWidth="440" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Connections sidebar -->
            <Border x:Name="ProfileSidebar" Background="{DynamicResource PanelBackground}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="16,12,14,8">
                        <TextBlock Text="Connections" Style="{StaticResource BodyStrongText}" VerticalAlignment="Center" />
                        <TextBlock x:Name="ConnectionCountText" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Grid DockPanel.Dock="Top" Margin="12,0,12,6">
                        <TextBox x:Name="SearchBox" Padding="8,0,30,0"
                                 local:UiAssist.Icon="&#xE721;"
                                 local:UiAssist.Placeholder="Search connections"
                                 TextChanged="SearchBox_TextChanged"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown"
                                 AutomationProperties.Name="Search connection profiles"
                                 AutomationProperties.HelpText="Search name, host, user, group, or notes"
                                 ToolTip="Search name, host, user, group, or notes (Ctrl+F)" />
                        <Button x:Name="SearchClearButton" Style="{StaticResource IconButton}"
                                Width="24" Height="24" HorizontalAlignment="Right" Margin="0,0,3,0"
                                local:UiAssist.Icon="&#xE711;" local:UiAssist.IconSize="10"
                                Click="ClearSearch_Click" Visibility="Collapsed" IsTabStop="False"
                                ToolTip="Clear search (Esc)"
                                AutomationProperties.Name="Clear profile search" />
                    </Grid>

                    <!-- List filter (All / Favourites / Recent) and density toggle -->
                    <Grid DockPanel.Dock="Top" Margin="12,0,10,6">
                        <StackPanel Orientation="Horizontal"
                                    KeyboardNavigation.TabNavigation="Once"
                                    KeyboardNavigation.DirectionalNavigation="Cycle"
                                    AutomationProperties.Name="Connection list filter">
                            <RadioButton x:Name="ShowAllButton" Content="All" GroupName="ConnectionFilter" IsChecked="True"
                                         Style="{StaticResource SegmentButton}" Checked="ConnectionFilter_Checked"
                                         ToolTip="All connections, by group"
                                         AutomationProperties.Name="Show all connections" />
                            <RadioButton x:Name="ShowFavoritesButton" Content="Favourites" GroupName="ConnectionFilter"
                                         Style="{StaticResource SegmentButton}" Checked="ConnectionFilter_Checked"
                                         Margin="2,0,0,0" ToolTip="Favourite connections only"
                                         AutomationProperties.Name="Show favourite connections" />
                            <RadioButton x:Name="ShowRecentButton" Content="Recent" GroupName="ConnectionFilter"
                                         Style="{StaticResource SegmentButton}" Checked="ConnectionFilter_Checked"
                                         Margin="2,0,0,0" ToolTip="Recently connected, most recent first"
                                         AutomationProperties.Name="Show recent connections" />
                        </StackPanel>
                        <ToggleButton x:Name="CompactListToggle" HorizontalAlignment="Right"
                                      Style="{StaticResource IconToggleButton}" Width="26" Height="26"
                                      local:UiAssist.Icon="&#xE8FD;" local:UiAssist.IconSize="14"
                                      Checked="CompactListToggle_Changed" Unchecked="CompactListToggle_Changed"
                                      ToolTip="Compact list: one line per connection"
                                      AutomationProperties.Name="Compact connection list" />
                    </Grid>

                    <Grid>
                        <ListBox x:Name="ConnectionsList" ItemsSource="{Binding ProfileView}" Padding="8,0,8,8"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 SelectionChanged="ConnectionsList_SelectionChanged"
                                 PreviewMouseRightButtonDown="ConnectionsList_PreviewMouseRightButtonDown"
                                 MouseDoubleClick="ConnectionsList_MouseDoubleClick"
                                 KeyDown="ConnectionsList_KeyDown"
                                 Expander.Expanded="ConnectionGroup_ExpansionChanged"
                                 Expander.Collapsed="ConnectionGroup_ExpansionChanged"
                                 AutomationProperties.Name="Connection profiles">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Connect" Tag="selection" Click="Connect_Click"
                                              local:UiAssist.Icon="&#xE768;" InputGestureText="Enter"
                                              AutomationProperties.Name="Connect selected profile" />
                                    <MenuItem Header="Edit…" Tag="selection" Click="Edit_Click"
                                              local:UiAssist.Icon="&#xE70F;" InputGestureText="F2"
                                              AutomationProperties.Name="Edit selected profile" />
                                    <MenuItem Header="Duplicate…" Tag="selection" Click="Duplicate_Click"
                                              local:UiAssist.Icon="&#xE8C8;"
                                              AutomationProperties.Name="Duplicate selected profile" />
                                    <MenuItem x:Name="FavoriteMenuItem" Header="Add to favourites" Tag="selection"
                                              Click="ToggleFavorite_Click"
                                              local:UiAssist.Icon="&#xE734;" InputGestureText="Ctrl+D"
                                              AutomationProperties.Name="Add selected profile to favourites" />
                                    <MenuItem Header="Remove" Tag="selection" Click="Remove_Click"
                                              local:UiAssist.Icon="&#xE74D;" InputGestureText="Del"
                                              AutomationProperties.Name="Remove selected profile" />
                                    <Separator />
                                    <MenuItem Header="New connection…" Click="Add_Click"
                                              local:UiAssist.Icon="&#xE710;" InputGestureText="Ctrl+N"
                                              AutomationProperties.Name="Create new connection profile" />
                                </ContextMenu>
                            </ListBox.ContextMenu>

                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="{x:Type GroupItem}">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                                        <Expander Style="{StaticResource GroupExpander}" Margin="0,4,0,0"
                                                                  IsExpanded="{Binding Name, Mode=OneTime, Converter={StaticResource GroupExpansionConverter}}">
                                                            <Expander.Header>
                                                                <DockPanel>
                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ItemCount}"
                                                                               FontSize="{StaticResource FontSizeCaption}" Margin="8,0,0,0" />
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                               FontSize="{StaticResource FontSizeCaption}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </DockPanel>
                                                            </Expander.Header>
                                                            <ItemsPresenter />
                                                        </Expander>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                </GroupStyle>
                            </ListBox.GroupStyle>

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavListItem}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                    <Setter Property="AutomationProperties.HelpText" Value="{Binding Address}" />
                                    <Setter Property="AutomationProperties.ItemStatus">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource AutomationStatusConverter}">
                                                <Binding Path="Id" />
                                                <Binding Path="DataContext.SessionIndicators" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                                <Binding Path="DataContext.FavoriteIds" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsCompactList, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                            <Setter Property="Padding" Value="{StaticResource ListItemPaddingCompact}" />
                                            <Setter Property="Margin" Value="{StaticResource ListItemMarginCompact}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <!-- One template for both densities; compact mode collapses the second line into an inline host. -->
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTipService.InitialShowDelay="900">
                                        <Grid.ToolTip>
                                            <StackPanel MaxWidth="340">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                                                    <Run Text="Host: " Foreground="{DynamicResource SecondaryText}" /><Run Text="{Binding Address, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock x:Name="TipUser" TextWrapping="Wrap">
                                                    <Run Text="User: " Foreground="{DynamicResource SecondaryText}" /><Run Text="{Binding Username, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock TextWrapping="Wrap">
                                                    <Run Text="Group: " Foreground="{DynamicResource SecondaryText}" /><Run Text="{Binding Group, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock x:Name="TipNotes" Text="{Binding Notes}" Margin="0,6,0,0"
                                                           TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" />
                                            </StackPanel>
                                        </Grid.ToolTip>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <local:Glyph x:Name="RowGlyph" Style="{StaticResource IconGlyph}" Text="&#xE7F4;" FontSize="16"
                                                   Foreground="{DynamicResource SecondaryText}"
                                                   VerticalAlignment="Top" Margin="0,2,10,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="Subtitle" Style="{StaticResource CaptionText}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0}  ·  {1}">
                                                        <Binding Path="Address" />
                                                        <Binding Path="Username" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock x:Name="InlineAddress" Grid.Column="2" Text="{Binding Address}"
                                                   Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="120" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Visibility="Collapsed" />
                                        <Button x:Name="FavoriteButton" Grid.Column="3" Style="{StaticResource RowFavoriteButton}"
                                                Margin="6,0,0,0" VerticalAlignment="Center" Click="RowFavorite_Click">
                                            <Button.Tag>
                                                <MultiBinding Converter="{StaticResource IdInSetConverter}">
                                                    <Binding Path="Id" />
                                                    <Binding Path="DataContext.FavoriteIds" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                                </MultiBinding>
                                            </Button.Tag>
                                        </Button>
                                        <Ellipse Grid.Column="4" Style="{StaticResource StateDot}" Margin="8,0,2,0">
                                            <Ellipse.Tag>
                                                <MultiBinding Converter="{StaticResource SessionIndicatorConverter}">
                                                    <Binding Path="Id" />
                                                    <Binding Path="DataContext.SessionIndicators" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                                </MultiBinding>
                                            </Ellipse.Tag>
                                        </Ellipse>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Username}" Value="">
                                            <Setter TargetName="Subtitle" Property="Text" Value="{Binding Address}" />
                                            <Setter TargetName="TipUser" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Notes}" Value="">
                                            <Setter TargetName="TipNotes" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DataContext.IsCompactList, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                            <Setter TargetName="Subtitle" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="InlineAddress" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="RowGlyph" Property="FontSize" Value="14" />
                                            <Setter TargetName="RowGlyph" Property="VerticalAlignment" Value="Center" />
                                            <Setter TargetName="RowGlyph" Property="Margin" Value="0,0,10,0" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="RowGlyph" Property="Foreground" Value="{DynamicResource SelectedText}" />
                                            <Setter TargetName="Subtitle" Property="Foreground" Value="{DynamicResource SelectedText}" />
                                            <Setter TargetName="InlineAddress" Property="Foreground" Value="{DynamicResource SelectedText}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel x:Name="ProfileEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="20,0,20,40" Visibility="Collapsed">
                            <local:Glyph x:Name="ProfileEmptyIcon" Style="{StaticResource IconGlyph}" Text="&#xE7F4;"
                                       FontSize="28" Foreground="{DynamicResource TertiaryText}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="ProfileEmptyTitle" Text="No connections yet" Style="{StaticResource BodyStrongText}"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" />
                            <TextBlock x:Name="ProfileEmptyMessage" Style="{StaticResource CaptionText}"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,14" />
                            <Button x:Name="ProfileEmptyAction" Content="New connection"
                                    Click="ProfileEmptyAction_Click" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Style="{StaticResource SidebarSplitter}"
                          Margin="-2,0" Panel.ZIndex="1"
                          AutomationProperties.Name="Resize connections sidebar" />

            <!-- Workspace -->
            <Grid Grid.Column="2" Background="{DynamicResource WindowBackground}">
                <TabControl x:Name="WorkspaceTabs"
                            Style="{StaticResource WorkspaceTabControl}"
                            ItemContainerStyle="{StaticResource WorkspaceTabItem}"
                            SelectionChanged="WorkspaceTabs_SelectionChanged"
                            AutomationProperties.Name="Remote sessions" />

                <Grid x:Name="EmptyWorkspace" Background="{DynamicResource WindowBackground}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Margin="24">
                        <local:Glyph Style="{StaticResource IconGlyph}" Text="&#xE7F4;" FontSize="40"
                                   Foreground="{DynamicResource TertiaryText}" HorizontalAlignment="Center" />
                        <TextBlock Text="No open sessions" Style="{StaticResource SubtitleText}"
                                   HorizontalAlignment="Center" Margin="0,16,0,0" />
                        <TextBlock Text="Double-click a connection or press Enter to open it in a new tab."
                                   Foreground="{DynamicResource SecondaryText}" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />

                        <!-- Quick access to recently used connections -->
                        <StackPanel x:Name="RecentConnectionsPanel" Margin="0,24,0,0" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Margin="10,0,0,6">
                                <local:Glyph Style="{StaticResource IconGlyph}" Text="&#xE81C;" FontSize="12"
                                             Foreground="{DynamicResource SecondaryText}" Margin="0,0,6,0" />
                                <TextBlock Text="Recent" Style="{StaticResource CaptionText}" FontWeight="SemiBold" />
                            </StackPanel>
                            <ItemsControl x:Name="RecentConnectionsList" ItemsSource="{Binding RecentProfiles}"
                                          Focusable="False" AutomationProperties.Name="Recent connections">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SubtleButton}" HorizontalContentAlignment="Left"
                                                Padding="10,0" MinHeight="32" Click="RecentConnection_Click"
                                                ToolTip="{Binding Address}"
                                                AutomationProperties.Name="{Binding Name, StringFormat='Connect to {0}'}">
                                            <StackPanel Orientation="Horizontal">
                                                <local:Glyph Style="{StaticResource IconGlyph}" Text="&#xE7F4;"
                                                             Foreground="{DynamicResource SecondaryText}" Margin="0,0,10,0" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                           MaxWidth="220" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Address}" Style="{StaticResource CaptionText}"
                                                           VerticalAlignment="Center" Margin="10,0,0,0"
                                                           MaxWidth="160" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Grid Margin="0,28,0,0" HorizontalAlignment="Center">
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Margin" Value="12,4,0,4" />
                                </Style>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                <RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border Style="{StaticResource Keycap}"><TextBlock Text="Ctrl" Margin="0" /></Border>
                                <Border Style="{StaticResource Keycap}"><TextBlock Text="N" Margin="0" /></Border>
                            </StackPanel>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="New connection" />

                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border Style="{StaticResource Keycap}"><TextBlock Text="Enter" Margin="0" /></Border>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Connect to selected" />

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border Style="{StaticResource Keycap}"><TextBlock Text="Ctrl" Margin="0" /></Border>
                                <Border Style="{StaticResource Keycap}"><TextBlock Text="F" Margin="0" /></Border>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Search connections" />

                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border Style="{StaticResource Keycap}"><TextBlock Text="Ctrl" Margin="0" /></Border>
                                <Border Style="{StaticResource Keycap}"><TextBlock Text="Shift" Margin="0" /></Border>
                                <Border Style="{StaticResource Keycap}"><TextBlock Text="P" Margin="0" /></Border>
                            </StackPanel>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Go to a connection, session, or command" />

                            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border Style="{StaticResource Keycap}"><TextBlock Text="Ctrl" Margin="0" /></Border>
                                <Border Style="{StaticResource Keycap}"><TextBlock Text="Tab" Margin="0" /></Border>
                            </StackPanel>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="Next session tab" />

                            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border Style="{StaticResource Keycap}"><TextBlock Text="Ctrl" Margin="0" /></Border>
                                <Border Style="{StaticResource Keycap}"><TextBlock Text="W" Margin="0" /></Border>
                            </StackPanel>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="Close session tab" />

                            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border Style="{StaticResource Keycap}"><TextBlock Text="F1" Margin="0" /></Border>
                            </StackPanel>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="All keyboard shortcuts" />
                        </Grid>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============================== Status bar ============================== -->
        <Border Grid.Row="2" Background="{DynamicResource HeaderBackground}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                Padding="12,0" MinHeight="26">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                           AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.HelpText="Application and session status" />
                <TextBlock x:Name="SessionSummaryText" Grid.Column="1" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" Margin="16,0,0,0" Text="No open sessions" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0" Background="Transparent"
                            ToolTip="Profiles are stored locally in %LOCALAPPDATA%\RDCM. Passwords are never saved; Remote Desktop prompts for credentials when needed.">
                    <local:Glyph Style="{StaticResource IconGlyph}" Text="&#xE72E;" FontSize="11"
                               Foreground="{DynamicResource SecondaryText}" Margin="0,0,6,0" />
                    <TextBlock Text="Passwords never saved" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
