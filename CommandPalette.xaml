<Window x:Class="RDCM.CommandPalette"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RDCM"
        Title="Command palette"
        Style="{StaticResource AppWindowStyle}"
        Width="600"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="{DynamicResource PopupBackground}"
        BorderBrush="{DynamicResource PopupBorder}"
        BorderThickness="1"
        AutomationProperties.Name="Command palette">
    <!--
        A separate top-level window rather than a Popup or adorner: the remote desktop surface is a native HWND,
        and WPF content in the main window can never be drawn over it.
    -->
    <DockPanel>
        <TextBox x:Name="QueryBox" DockPanel.Dock="Top" Margin="10,10,10,8" MinHeight="34" Padding="8,0,8,0"
                 local:UiAssist.Icon="&#xE721;"
                 local:UiAssist.Placeholder="Search connections, sessions, and commands"
                 AutomationProperties.Name="Search connections, open sessions, and commands"
                 AutomationProperties.HelpText="Type to filter. Start with &gt; to show commands only. Use the arrow keys to choose a result and Enter to run it." />

        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerBrush}"
                Padding="12,6,12,7">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource CaptionText}"
                           Foreground="{DynamicResource TertiaryText}"
                           Text="↑↓ Select  ·  Enter Run  ·  Esc Close  ·  &gt; Commands only" />
                <TextBlock x:Name="ResultCountText" Style="{StaticResource CaptionText}"
                           AutomationProperties.LiveSetting="Polite" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid>
            <ListBox x:Name="ResultsList" MaxHeight="388" Padding="6,0,6,6"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Results">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavListItem}">
                        <Setter Property="Padding" Value="10,6,8,6" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                        <Setter Property="AutomationProperties.AcceleratorKey" Value="{Binding Shortcut}" />
                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="ResultItem_Click" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:PaletteItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:Glyph Style="{StaticResource IconGlyph}" Text="{Binding Icon}" FontSize="15"
                                         Foreground="{DynamicResource SecondaryText}" Margin="0,0,12,0" />
                            <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                       MaxWidth="300" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Subtitle}" Style="{StaticResource CaptionText}"
                                       TextTrimming="CharacterEllipsis" Margin="10,0,8,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <ItemsControl ItemsSource="{Binding ShortcutKeys}" Focusable="False" Margin="0,0,6,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Keycap}">
                                                <TextBlock Text="{Binding}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource CaptionText}"
                                           Foreground="{DynamicResource TertiaryText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="NoResultsText" Visibility="Collapsed" Margin="16,8,16,16"
                       Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" />
        </Grid>
    </DockPanel>
</Window>
